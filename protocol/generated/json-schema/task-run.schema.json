{
  "$id": "https://schemas.blueclaw.dev/0.4.0/task-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "currentAgentProfileName": {
      "type": "string"
    },
    "currentAttemptID": {
      "type": "string"
    },
    "failureReason": {
      "type": "string"
    },
    "originConversationID": {
      "type": "string"
    },
    "originIsThread": {
      "type": "boolean"
    },
    "originReplyTargetID": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "requesterPersonID": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "waiting_user_input",
        "waiting_approval",
        "blocked",
        "interrupted",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "taskRunID": {
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    }
  },
  "required": [
    "taskRunID",
    "requesterPersonID",
    "originConversationID",
    "currentAgentProfileName",
    "status",
    "prompt",
    "result",
    "failureReason",
    "createdAt",
    "updatedAt"
  ],
  "type": "object"
}
