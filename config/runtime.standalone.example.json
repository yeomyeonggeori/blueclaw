{
  "baseURL": "http://127.0.0.1:8081",
  "languageModel": {
    "tiers": {
      "xlow": [{ "endpoint": "http://127.0.0.1:11434/v1", "model": "your-model" }],
      "low": [{ "endpoint": "http://127.0.0.1:11434/v1", "model": "your-model" }],
      "medium": [{ "endpoint": "http://127.0.0.1:11434/v1", "model": "your-model" }],
      "high": [{ "endpoint": "http://127.0.0.1:11434/v1", "model": "your-model" }],
      "xhigh": [{ "endpoint": "http://127.0.0.1:11434/v1", "model": "your-model" }],
      "max": [{ "endpoint": "http://127.0.0.1:11434/v1", "model": "your-model" }]
    },
    "embedding": {
      "endpoint": "http://127.0.0.1:11434/v1",
      "model": "your-embedding-model"
    }
  },
  "database": {
    "driver": "postgres",
    "connectionString": "postgres://blueclaw:blueclaw@127.0.0.1:5432/blueclaw?sslmode=disable",
    "migrationDirectoryPath": "migrations"
  },
  "agent": {
    "intake": {
      "enabled": true,
      "executionMode": "auto"
    },
    "defaultTaskLevel": "low",
    "harness": {
      "name": "claude-code",
      "agentCommandPath": "/usr/local/bin/claude"
    }
  },
  "connectors": {},
  "logging": {
    "directoryPath": ".local/blueclaw/logs",
    "retentionDays": 7
  },
  "terminal": {
    "mode": "native",
    "workspaceRootPath": ".local/blueclaw/workspace",
    "timeoutSecond": 120,
    "outputMaxBytes": 32768,
    "sessionMaxCount": 4,
    "allowNetwork": true
  },
  "scheduler": {
    "retentionCheckIntervalMinute": 60,
    "taskSchedulePollIntervalSecond": 30
  }
}
