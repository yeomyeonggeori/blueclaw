{
  "baseURL": "http://127.0.0.1:8081",
  "languageModel": {
    "tiers": {
      "xlow": [
        {
          "endpoint": "${BLUECLAW_MODEL_ENDPOINT}",
          "model": "${BLUECLAW_MODEL}",
          "apiKeyEnvironment": "OPENROUTER_API_KEY",
          "providerSort": "throughput",
          "reasoningEffort": "minimal"
        }
      ],
      "low": [
        {
          "endpoint": "${BLUECLAW_MODEL_ENDPOINT}",
          "model": "${BLUECLAW_MODEL}",
          "apiKeyEnvironment": "OPENROUTER_API_KEY",
          "providerSort": "throughput",
          "reasoningEffort": "low"
        }
      ],
      "medium": [
        {
          "endpoint": "${BLUECLAW_MODEL_ENDPOINT}",
          "model": "${BLUECLAW_MODEL}",
          "apiKeyEnvironment": "OPENROUTER_API_KEY",
          "providerSort": "throughput",
          "reasoningEffort": "medium"
        }
      ],
      "high": [
        {
          "endpoint": "${BLUECLAW_MODEL_ENDPOINT}",
          "model": "${BLUECLAW_MODEL}",
          "apiKeyEnvironment": "OPENROUTER_API_KEY",
          "providerSort": "throughput",
          "reasoningEffort": "high"
        }
      ],
      "xhigh": [
        {
          "endpoint": "${BLUECLAW_MODEL_ENDPOINT}",
          "model": "${BLUECLAW_MODEL}",
          "apiKeyEnvironment": "OPENROUTER_API_KEY",
          "providerSort": "throughput",
          "reasoningEffort": "xhigh"
        }
      ],
      "max": [
        {
          "endpoint": "${BLUECLAW_MODEL_ENDPOINT}",
          "model": "${BLUECLAW_MODEL}",
          "apiKeyEnvironment": "OPENROUTER_API_KEY",
          "providerSort": "throughput",
          "reasoningEffort": "max"
        }
      ]
    },
    "embedding": {
      "endpoint": "${BLUECLAW_MODEL_ENDPOINT}",
      "model": "${BLUECLAW_EMBEDDING_MODEL}",
      "apiKeyEnvironment": "OPENROUTER_API_KEY"
    },
    "decision": {
      "endpoint": "${BLUECLAW_DECISION_ENDPOINT}",
      "model": "${BLUECLAW_DECISION_MODEL}",
      "apiKeyEnvironment": "OPENROUTER_API_KEY"
    }
  },
  "database": {
    "driver": "postgres",
    "connectionString": "${BLUECLAW_DATABASE_URL}",
    "migrationDirectoryPath": "migrations"
  },
  "agent": {
    "intake": {
      "enabled": true,
      "executionMode": "auto"
    },
    "defaultTaskLevel": "low"
  },
  "connectors": {},
  "logging": {
    "directoryPath": ".local/blueclaw/logs",
    "retentionDays": 7
  },
  "terminal": {
    "mode": "native",
    "workspaceRootPath": ".local/blueclaw/workspace",
    "timeoutSecond": 120,
    "outputMaxBytes": 32768,
    "sessionMaxCount": 4,
    "allowNetwork": true
  },
  "scheduler": {
    "retentionCheckIntervalMinute": 60,
    "taskSchedulePollIntervalSecond": 30
  }
}
