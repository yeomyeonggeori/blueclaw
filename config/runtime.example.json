{
  "baseURL": "http://127.0.0.1:8080",
  "capabilities": {
    "endpoint": "http://127.0.0.1:7781",
    "unixSocketPath": "/run/blueclaw/capability.sock",
    "timeoutSecond": 15,
    "toolNames": [
      "browser_open",
      "user_confirm",
      "file_pick"
    ],
    "toolDescriptors": [
      {
        "name": "browser_open",
        "version": "1",
        "privacyClass": "device_browser",
        "estimatedLatency": "interactive",
        "requiresUserPresence": false,
        "worksOffline": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "startURL": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sideEffectClass": "browser"
      },
      {
        "name": "user_confirm",
        "version": "1",
        "privacyClass": "user_input",
        "estimatedLatency": "interactive",
        "requiresUserPresence": true,
        "worksOffline": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        },
        "sideEffectClass": "approval",
        "requiresApproval": true
      },
      {
        "name": "file_pick",
        "version": "1",
        "privacyClass": "local_file",
        "estimatedLatency": "interactive",
        "requiresUserPresence": true,
        "worksOffline": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "accept": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "multiple": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "sideEffectClass": "local_file",
        "requiresApproval": true
      }
    ]
  },
  "languageModel": {
    "contextWindowTokens": 1048576,
    "embedding": {
      "model": "google/embeddinggemma-2"
    },
    "capability": {
      "executionMode": "auto",
      "xlowModel": "your-model",
      "lowModel": "your-model",
      "mediumModel": "your-model",
      "highModel": "your-model",
      "xhighModel": "your-model",
      "maxModel": "your-model"
    }
  },
  "database": {
    "driver": "postgres",
    "connectionString": "postgres://blueclaw@/blueclaw?host=/var/run/postgresql&sslmode=disable",
    "migrationDirectoryPath": "/workspace/.blueclaw/migrations",
    "maxOpenConnections": 30
  },
  "memory": {
    "embeddingModel": "google/embeddinggemma-2",
    "embeddingDimensions": 768,
    "embeddingExecutionMode": "auto",
    "extractionDisabled": false
  },
  "agent": {
    "intake": {
      "enabled": true,
      "executionMode": "auto"
    },
    "failureRecovery": {
      "failureDebtFinalizationGate": true,
      "attemptFingerprint": "tool_input_error_code",
      "recoveryBudget": {
        "correctedRetry": 1,
        "alternateRoute": 1,
        "adjacentTool": 2,
        "noToolFallback": 1
      }
    }
  },
  "connectors": {
    "mattermost": {},
    "slack": {},
    "signal": {
      "enabled": false
    },
    "chatd": {
      "endpoint": "http://127.0.0.1:18090",
      "enabledPlatforms": []
    }
  },
  "logging": {
    "directoryPath": "/workspace/.blueclaw/logs",
    "retentionDays": 7
  },
  "agentProfiles": [
    {
      "name": "planner",
      "allowedToolNames": [
        "workspace.list"
      ]
    },
    {
      "name": "researcher",
      "allowedToolNames": [
        "workspace.read"
      ]
    }
  ],
  "terminal": {
    "mode": "native",
    "workspaceRootPath": "/workspace",
    "timeoutSecond": 120,
    "outputMaxBytes": 32768,
    "sessionMaxCount": 4,
    "allowNetwork": true,
    "allowInteractiveShell": true
  },
  "scheduler": {
    "retentionCheckIntervalMinute": 60,
    "taskSchedulePollIntervalSecond": 30
  }
}
