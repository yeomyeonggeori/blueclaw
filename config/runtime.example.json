{
  "baseURL": "http://127.0.0.1:8080",
  "capabilities": {
    "endpoint": "http://127.0.0.1:7781",
    "unixSocketPath": "/run/blueclaw/capability.sock",
    "timeoutSecond": 15,
    "toolNames": [
      "browser_open",
      "user_confirm",
      "file_pick"
    ],
    "toolDescriptors": [
      {
        "name": "browser_open",
        "version": "1",
        "privacyClass": "user_browser",
        "estimatedLatency": "interactive",
        "requiresUserPresence": true,
        "worksOffline": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "startURL": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sideEffectClass": "browser"
      },
      {
        "name": "user_confirm",
        "version": "1",
        "privacyClass": "user_input",
        "estimatedLatency": "interactive",
        "requiresUserPresence": true,
        "worksOffline": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        },
        "sideEffectClass": "approval",
        "requiresApproval": true
      },
      {
        "name": "file_pick",
        "version": "1",
        "privacyClass": "local_file",
        "estimatedLatency": "interactive",
        "requiresUserPresence": true,
        "worksOffline": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "accept": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "multiple": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "sideEffectClass": "local_file",
        "requiresApproval": true
      }
    ]
  },
  "languageModel": {
    "defaultProvider": "capabilityLLM",
    "capability": {
      "executionMode": "auto"
    }
  },
  "guest": {
    "virtualMachineMonitor": "cloudHypervisor",
    "cloudHypervisorPath": "/usr/local/bin/cloud-hypervisor",
    "virtiofsdPath": "/usr/local/bin/virtiofsd",
    "kernelImagePath": "/opt/blueclaw/blueclaw-runtime/vmlinux.bin",
    "rootfsImagePath": "/opt/blueclaw/blueclaw-runtime/rootfs.ext4",
    "workspaceImagePath": "/var/lib/blueclaw/workspace.ext4",
    "vcpuCount": 4,
    "memoryMiB": 8192,
    "vsockCID": 52,
    "healthPortOrService": "8082",
    "guestHTTPPortOrService": "8081",
    "hostHTTPListenAddress": "127.0.0.1:8080",
    "logDirectoryPath": "/var/log/blueclaw-supervisor",
    "runtimeDirectoryPath": "/var/lib/bc",
    "outboundNetwork": {
      "enabled": true,
      "hostDeviceName": "bctap0",
      "guestMACAddress": "AA:FC:00:00:00:01",
      "networkCIDR": "172.31.0.0/30",
      "hostAddressCIDR": "172.31.0.1/30",
      "guestAddressCIDR": "172.31.0.2/30",
      "guestGateway": "172.31.0.1"
    }
  },
  "bridge": {
    "mode": "localAgent",
    "authMode": "sshKeyReuse",
    "authorizedPublicKeysPath": "/var/lib/blueclaw/authorized_companions",
    "listenAddress": "127.0.0.1:7778"
  },
  "database": {
    "driver": "postgres",
    "connectionString": "postgres://blueclaw@/blueclaw?host=/var/run/postgresql&sslmode=disable",
    "migrationDirectoryPath": "/workspace/.blueclaw/migrations"
  },
  "memory": {
    "workspaceID": "default",
    "graphitiEndpoint": "http://127.0.0.1:7791",
    "graphitiKuzuPath": "/workspace/.blueclaw/graphiti/kuzu",
    "timeoutSecond": 15,
    "embeddingModel": "qwen/qwen3-embedding-8b",
    "embeddingExecutionMode": "auto",
    "extractionDisabled": false
  },
  "agent": {
    "intake": {
      "enabled": true,
      "executionMode": "auto"
    },
    "defaultTaskLevel": "low",
    "failureRecovery": {
      "failureDebtFinalizationGate": true,
      "attemptFingerprint": "tool_input_error_code",
      "recoveryBudget": {
        "correctedRetry": 1,
        "alternateRoute": 1,
        "adjacentTool": 2,
        "noToolFallback": 1
      }
    }
  },
  "connectors": {
    "mattermost": {},
    "slack": {},
    "signal": {
      "enabled": false
    },
    "chatd": {
      "endpoint": "http://127.0.0.1:18090",
      "enabledPlatforms": []
    }
  },
  "logging": {
    "directoryPath": "/workspace/.blueclaw/logs",
    "retentionDays": 7
  },
  "agentProfiles": [
    {
      "name": "planner",
      "allowedToolNames": [
        "workspace.list"
      ]
    },
    {
      "name": "researcher",
      "allowedToolNames": [
        "workspace.read"
      ]
    }
  ],
  "mcpServers": [
    {
      "name": "workspace",
      "transport": "stdio",
      "command": "blueclaw-mcp-workspace",
      "tools": [
        {
          "name": "list",
          "namespace": "workspace",
          "description": "List readable workspace files.",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "paths"
            ],
            "additionalProperties": false
          },
          "resultContract": {
            "schema": {
              "type": "object",
              "properties": {
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "paths"
              ],
              "additionalProperties": false
            }
          },
          "policy": {
            "privacyClass": "workspace",
            "requiresUserPresence": false,
            "worksOffline": true,
            "modelVisibility": "visible",
            "policyResource": "tool:workspace.list",
            "sideEffectClass": "read",
            "requiresApproval": false,
            "completionMode": "none",
            "idempotency": "supported",
            "idempotencyScope": "operation"
          }
        },
        {
          "name": "read",
          "namespace": "workspace",
          "description": "Read one workspace text file.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false
          },
          "resultContract": {
            "schema": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "policy": {
            "privacyClass": "workspace",
            "requiresUserPresence": false,
            "worksOffline": true,
            "modelVisibility": "visible",
            "policyResource": "tool:workspace.read",
            "sideEffectClass": "read",
            "requiresApproval": false,
            "completionMode": "none",
            "idempotency": "supported",
            "idempotencyScope": "operation"
          }
        }
      ]
    }
  ],
  "terminal": {
    "mode": "virtualMachineGuest",
    "workspaceRootPath": "/workspace",
    "timeoutSecond": 120,
    "outputMaxBytes": 32768,
    "sessionMaxCount": 4,
    "allowNetwork": true,
    "allowInteractiveShell": true
  },
  "scheduler": {
    "retentionCheckIntervalMinute": 60,
    "taskSchedulePollIntervalSecond": 30
  }
}
