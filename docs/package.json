{
  "name": "blueclaw-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/content.ts && bun scripts/og.ts && react-router build",
    "dev": "bun scripts/content.ts && react-router dev",
    "content": "bun scripts/content.ts",
    "types:check": "bun scripts/content.ts && react-router typegen && tsc --noEmit",
    "deploy": "bun run build && wrangler pages deploy build/client --project-name blueclaw-docs --branch main",
    "preview": "wrangler pages dev build/client"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.12",
    "fumadocs-mdx": "15.4.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.12",
    "isbot": "^5.2.2",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "^2.14.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react-router-devtools": "^6.2.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4"
  }
}
