#!/usr/bin/env python3
"""Print every tool the model can see and what its description costs.

The catalog is read from the source that registers it, so this never drifts from
what a turn actually carries."""

import pathlib
import re
import sys

SOURCE_ROOT = pathlib.Path(__file__).resolve().parent.parent / "internal" / "agentruntime"
DEFINITION = re.compile(r"toolcontract\.ToolDefinition\{(.*?)\n\t*\}", re.S)
NAME = re.compile(r'Name:\s*(?:toolcontract\.)?([A-Za-z0-9_".]+)')
DESCRIPTION = re.compile(r'Description:\s*"((?:[^"\\]|\\.)*)"')


def registered_tools():
    for path in sorted(SOURCE_ROOT.glob("*.go")):
        if path.name.endswith("_test.go"):
            continue
        text = path.read_text()
        for definition in DEFINITION.finditer(text):
            block = definition.group(1)
            name = NAME.search(block)
            if not name:
                continue
            description = DESCRIPTION.search(block)
            yield path.name, name.group(1).strip('"'), len(description.group(1)) if description else 0


def main():
    tools = sorted(registered_tools(), key=lambda tool: -tool[2])
    if not tools:
        print("no tool definitions found; the extraction stopped matching the source", file=sys.stderr)
        return 1
    for source, name, description_bytes in tools:
        print(f"{description_bytes:>5}  {name:<24} {source}")
    print(f"{sum(tool[2] for tool in tools):>5}  {len(tools)} tools, description bytes in total")
    return 0


if __name__ == "__main__":
    sys.exit(main())
